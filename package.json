{
  "name": "pkt-block-topo",
  "private": true,
  "version": "0.0.0",
  "description": "Block topology for tactical and illustrated maps: columns, holes, spans, a Three.js mesh and a light Vue editor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@1337exp/taoui": "^5.16.2",
    "@1337exp/taoux": "^0.5.5",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
