{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@editor/*": ["./src/editor/*"],
      "@server/*": ["./src/server/*"],
      "@core/*": ["./src-exp/core/*"],
      "@three/*": ["./src-exp/three/*"]
    }
  },
  "include": ["./src/**/*.ts", "src/**/*.vue", "./src-exp/**/*.ts", "src-exp/**/*.vue", "tests", "tests-exp", "vite.config.ts"]
}
